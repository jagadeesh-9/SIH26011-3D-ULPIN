# SIH26011: 3D ULPIN Research Prototype Environment Configuration
# Copy this file to .env and replace placeholders with your local environment values.

# Database Configuration (PostgreSQL 16 + PostGIS)
# Local example:
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5432/sih26011_dev
# Cloud example (Render / Railway / Supabase / Neon):
# DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>

# Application Server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False

# Analysis Coordinate Reference System
ANALYSIS_SRID=32644

# Production CORS Configuration
# Set this to your deployed Vercel domain (comma-separated if multiple):
# FRONTEND_ORIGIN=https://sih26011-3d-ulpin.vercel.app
